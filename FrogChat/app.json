{
  "expo": {
    "name": "FrogChat",
    "slug": "frogchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vanditjain.frogchat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.vanditjain.frogchat"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "frogchat"
  }
}
